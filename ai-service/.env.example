# AI Service Configuration
INTERNAL_API_KEY=changeme-internal-key
FRONTEND_URL=http://localhost:5173
# Backend service URL (used by AI service for internal API calls)
# Local dev: http://localhost:3000
# Docker Compose: http://backend:3000
BACKEND_URL=http://localhost:3000
# Also accepts OPEN_API_KEY as fallback
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Database
DATABASE_URL=postgresql://appuser:devpassword@localhost:5432/conflicts_db

# Redis
REDIS_URL=redis://localhost:6379

# Chroma
CHROMA_DB_PATH=./chroma_db

# Environment
ENVIRONMENT=development

# Model overrides (optional — defaults come from settings.yaml)
# PRIMARY_MODEL=claude-sonnet-4-6
# PRIMARY_TEMPERATURE=0.3
# PRIMARY_MAX_TOKENS=2000
# EXTRACTION_MODEL=gpt-4o-mini
# EMBEDDINGS_MODEL=text-embedding-3-large

# Workflow overrides (optional)
# NEWS_RETRIEVAL_K=20
# INFRASTRUCTURE_RADIUS_KM=200
# CORRELATION_THRESHOLD=0.3

# Tiingo financial news (https://www.tiingo.com/account/api/token)
TIINGO_API_KEY=your-tiingo-api-key
