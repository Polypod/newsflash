# Server Configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://appuser:devpassword@localhost:5432/conflicts_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# External APIs
# ACLED (https://acleddata.com/) — token is obtained automatically via OAuth
ACLED_EMAIL=your-acled-email@example.com
ACLED_PASSWORD=your-acled-password
# UCDP (https://ucdp.uu.se/apidocs/) — request token via ucdp.uu.se
UCDP_ACCESS_TOKEN=your-ucdp-access-token
# EIA (https://www.eia.gov/opendata/)
EIA_API_KEY=your-eia-api-key
# AviationStack (https://aviationstack.com/) — also accepts AVIATIONSTACK_API
AVIATIONSTACK_API_KEY=your-aviationstack-api-key
# NewsAPI (https://newsapi.org/)
NEWS_API_KEY=your_newsapi_org_key_here

# AI Services — also accepts OPEN_API_KEY as fallback for OpenAI
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Mapbox
MAPBOX_TOKEN=your-mapbox-token

# Frontend
FRONTEND_URL=http://localhost:5173

# AI Service
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=changeme-internal-key

# API Auth
API_USERNAME=admin
API_PASSWORD=changeme-strong-password

# Logging
LOG_LEVEL=info
LOG_DIR=logs
